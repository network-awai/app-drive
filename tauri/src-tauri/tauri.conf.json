{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Awai Drive",
  "version": "0.1.0",
  "identifier": "network.awai.drive",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Awai Drive",
        "width": 900,
        "height": 820,
        "minWidth": 320,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src  ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "GIFTED AGENT LLC",
    "copyright": "Copyright © 2026 GIFTED AGENT LLC",
    "category": "Productivity",
    "shortDescription": "Awai Drive",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": null
    }
  }
}
